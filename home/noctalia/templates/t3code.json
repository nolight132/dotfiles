{
  "version": 1,
  "name": "Rosépuccin Noctalia",
  "appearance": "{{mode}}",
  "canvas": "{{colors.surface.default.hex}}",
  "accent": "{{colors.primary.default.hex}}",
  "colors": {
    "canvas": "{{colors.surface.default.hex}}",
    "chrome": "{{colors.surface.default.rgba | set_alpha: 0.88}}",
    "toolbar": "rgba(0, 0, 0, 0)",
    "toolbarForeground": "{{colors.on_surface_variant.default.hex}}",
    "toolbarBorder": "{{colors.surface_container.default.hex}}",
    "toolbarControl": "{{colors.surface_container_low.default.hex}}",
    "toolbarControlForeground": "{{colors.on_surface_variant.default.hex}}",
    "toolbarControlHover": "{{colors.surface_container.default.hex}}",
    "surface": "{{colors.surface_container_low.default.hex}}",
    "surfaceRaised": "{{colors.surface_container_low.default.hex}}",
    "surfaceOverlay": "{{colors.surface_container.default.hex}}",
    "text": "{{colors.on_surface_variant.default.hex}}",
    "textMuted": "{{colors.outline.default.hex}}",
    "border": "{{colors.surface_container_high.default.hex}}",
    "input": "{{colors.surface_container_high.default.hex}}",
    "focus": "{{colors.primary.default.hex}}",
    "accent": "{{colors.primary.default.hex}}",
    "accentForeground": "{{colors.on_primary.default.hex}}",
    "secondary": "{{colors.surface_container.default.hex}}",
    "secondaryForeground": "{{colors.on_surface_variant.default.hex}}",
    "muted": "{{colors.surface_container_low.default.hex}}",
    "mutedForeground": "{{colors.outline.default.hex}}",
    "placeholder": "{{colors.outline.default.hex}}",
    "secondaryLabel": "{{colors.outline.default.hex}}",
    "iconMuted": "{{colors.outline.default.hex}}",
    "error": "{{colors.error.default.hex}}",
    "errorForeground": "{{colors.error.default.hex}}",
    "errorSurface": "{{colors.error_container.default.rgba | set_alpha: 0.3}}",
    "warning": "{{colors.warning.default.hex}}",
    "warningForeground": "{{colors.warning.default.hex}}",
    "warningSurface": "{{colors.warning_container.default.rgba | set_alpha: 0.3}}",
    "update": "{{colors.primary.default.hex}}",
    "updateForeground": "{{colors.primary.default.hex}}",
    "updateSurface": "{{colors.primary_container.default.rgba | set_alpha: 0.3}}",
    "accentSurface": "{{colors.surface_container.default.hex}}",
    "accentSurfaceForeground": "{{colors.on_surface.default.hex}}",
    "messageSurface": "{{colors.surface_container.default.hex}}",
    "messageForeground": "{{colors.on_surface_variant.default.hex}}",
    "messageAction": "{{colors.primary.default.hex}}",
    "messageActionForeground": "{{colors.on_primary.default.hex}}",
    "messageActionHover": "{{colors.primary_fixed_dim.default.hex}}",
    "codeBackground": "{{colors.surface_container_low.default.hex}}",
    "codeForeground": "{{colors.on_surface_variant.default.hex}}",
    "sidebar": "{{colors.surface_container_lowest.default.rgba | set_alpha: 0.5}}",
    "sidebarForeground": "{{colors.on_surface_variant.default.hex}}",
    "sidebarMutedForeground": "{{colors.outline.default.hex}}",
    "sidebarControlSurface": "{{colors.surface_container_low.default.hex}}",
    "sidebarRowHover": "{{colors.surface_container_low.default.hex}}",
    "sidebarRowActive": "{{colors.surface_container.default.hex}}",
    "sidebarRowSelected": "{{colors.surface_container_low.default.hex}}",
    "sidebarBorder": "{{colors.surface_container_low.default.hex}}",
    "terminalBackground": "{{colors.background.default.rgba | set_alpha: 0.88}}",
    "terminalForeground": "{{colors.on_surface_variant.default.hex}}",
    "terminalCursor": "{{colors.primary.default.hex | lighten: 40}}",
    "terminalSelection": "{{colors.surface_container_high.default.hex}}",
    "terminalScrollbar": "{{colors.surface_container_high.default.hex}}",
    "terminalScrollbarHover": "{{colors.outline_variant.default.hex}}"
  }
}
